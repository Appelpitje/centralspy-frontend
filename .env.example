# API and WebSocket configuration
# For production: https://portal.mohpa.net and wss://portal.mohpa.net
# For local dev: leave empty to use Vite's built-in dev proxy to localhost:3000
VITE_API_URL=https://portal.mohpa.net
VITE_WS_URL=wss://portal.mohpa.net

# Cloudflare Turnstile sitekey is public (it ships in the JS bundle).
# Official dummy always-pass key for local: 1x00000000000000000000AA
# Production: set this in CI / Cloudflare Pages build env, not in git.
VITE_TURNSTILE_SITE_KEY=
